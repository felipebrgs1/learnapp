              "x": 3.5,
              "y": 5.2,
              "w": 5,
              "h": 2.4,
              "sub": ".git/objects",
              "variant": "accent"
            }
          ],
          "edges": [
            {
              "from": "wt",
              "to": "idx",
              "label": "add"
            },
            {
              "from": "idx",
              "to": "repo",
              "label": "commit"
            },
            {
              "from": "repo",
