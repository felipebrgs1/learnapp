              "—"
            ],
            [
              "tree",
              "Uma listagem de diretório: nomes, modos e hashes",
              "blobs e outras trees"
            ],
            [
              "commit",
              "Autor, committer, data, mensagem",
              "uma tree (o snapshot) e zero ou mais pais"
            ],
            [
              "tag",
              "Tag anotada: nome, autor, mensagem, assinatura opcional",
              "normalmente um commit"
            ]
          ]
        },
